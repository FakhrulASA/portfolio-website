el: 'Home' },\n    { to: '/about', label: 'About' },\n    { to: '/projects', label: 'Projects' },\n    { to: '/contact', label: 'Contact' },\n  ];\n\n  return (\n    <header className={`navbar${scrolled ? ' scrolled' : ''}`}>\n      <div className=\"nav-container\">\n        <Link to=\"/\" className=\"nav-brand\">FA</Link>\n        <nav>\n          <ul className=\"nav-links\">\n            {links.map(({ to, label }) => (\n              <li key={to}>\n                <Link\n                  to={to}\n                  className={`nav-link${location.pathname === to ? ' active' : ''}`}\n                >\n                  {label}\n                </Link>\n              </li>\n            ))}\n          </ul>\n        </nav>\n      </div>\n    </header>\n  );\n};\n\nexport default Header;"],"mappings":"AAAA,MAAO,CAAAA,KAAK,EAAIC,QAAQ,CAAEC,SAAS,KAAQ,OAAO,CAClD,OAASC,IAAI,CAAEC,WAAW,KAAQ,kBAAkB,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAErD,KAAM,CAAAC,MAAgB,CAAGA,CAAA,GAAM,CAC7B,KAAM,CAACC,QAAQ,CAAEC,WAAW,CAAC,CAAGV,QAAQ,CAAC,KAAK,CAAC,CAC/C,KAAM,CAAAW,QAAQ,CAAGR,WAAW,CAAC,CAAC,CAE9BF,SAAS,CAAC,IAAM,CACd,KAAM,CAAAW,QAAQ,CAAGA,CAAA,GAAMF,WAAW,CAACG,MAAM,CAACC,OAAO,CAAG,EAAE,CAAC,CACvDD,MAAM,CAACE,gBAAgB,CAAC,QAAQ,CAAEH,QAAQ,CAAC,CAC3C,MAAO,IAAMC,MAAM,CAACG,mBAAmB,CAAC,QAAQ,CAAEJ,QAAQ,CAAC,CAC7D,CAAC,CAAE,EAAE,CAAC,CAEN,KAAM,CAAAK,KAAK,CAAG,CACZ,CAAEC,EAAE,CAAE,GAAG,CAAEC,KAAK,CAAE,MAAO,CAAC,CAC1B,CAAED,EAAE,CAAE,QAAQ,CAAEC,KAAK,CAAE,OAAQ,CAAC,CAChC,CAAED,EAAE,CAAE,WAAW,CAAEC,KAAK,CAAE,UAAW,CAAC,CACtC,CAAED,EAAE,CAAE,UAAU,CAAEC,KAAK,CAAE,SAAU,CAAC,CACrC,CAED,mBACEd,IAAA,WAAQe,SAAS,CAAE,SAASX,QAAQ,CAAG,WAAW,CAAG,EAAE,EAAG,CAAAY,QAAA,cACxDd,KAAA,QAAKa,SAAS,CAAC,eAAe,CAAAC,QAAA,eAC5BhB,IAAA,CAACH,IAAI,EAACgB,EAAE,CAAC,GAAG,CAACE,SAAS,CAAC,WAAW,CAAAC,QAAA,CAAC,IAAE,CAAM,CAAC,cAC5ChB,IAAA,QAAAgB,QAAA,cACEhB,IAAA,OAAIe,SAAS,CAAC,WAAW,CAAAC,QAAA,CACtBJ,KAAK,CAACK,GAAG,CAACC,IAAA,MAAC,CAAEL,EAAE,CAAEC,KAAM,CAAC,CAAAI,IAAA,oBACvBlB,IAAA,OAAAgB,QAAA,cACEhB,IAAA,CAACH,IAAI,